{
    "name": "autoi18n",
    "version": "0.1.0",
    "description": "自动国际化",
    "main": "./dist/index.umd.js",
    "files": [
        "dist"
    ],
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.es.js",
            "require": "./dist/index.umd.js"
        }
    },
    "keywords": [
        "autoi18n",
        "i18n"
    ],
    "scripts": {
        "dev": "vite",
        "preview": "vite preview",
        "ts:build": "tsc --build src/autoi18n/tsconfig.json",
        "build": "vite --config vite.build.config.ts build --mode production",
        "cp:type": "cp src/autoi18n/buildTypes/index.d.ts dist",
        "plugin:build": "pnpm run ts:build && pnpm run build && pnpm run cp:type",
        "push:npm:package": "gulp versionPatch && gulp npmPackagePush",
        "plugin:build:push:npm:package": "pnpm run plugin:build && pnpm run push:npm:package"
    },
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@types/dom-webcodecs": "^0.1.7",
        "@types/node": "^20.3.1",
        "@vitejs/plugin-vue": "^4.2.3",
        "@vue/runtime-core": "^3.3.4",
        "@webgpu/types": "^0.1.33",
        "axios": "^1.4.0",
        "crypto-js": "^4.1.1",
        "css-vars-ponyfill": "^2.4.8",
        "gl-matrix": "^3.4.3",
        "gpu-matrix": "^0.0.0",
        "less": "^4.1.3",
        "less-loader": "^11.1.3",
        "lodash": "^4.17.21",
        "matias-pinia-persisted-state": "^0.2.0",
        "node-fetch": "^3.3.1",
        "pinia": "^2.1.4",
        "rollup": "^3.26.3",
        "rollup-plugin-terser": "^7.0.2",
        "sass": "^1.63.4",
        "sass-loader": "^13.3.2",
        "ts-node": "^10.9.1",
        "typescript": "^5.1.3",
        "vite": "^4.3.9",
        "vite-plugin-inspect": "^0.7.28",
        "vue": "^3.3.4",
        "vue-i18n": "^9.2.2",
        "vue-router": "^4.2.2",
        "wgpu-matrix": "^2.4.2"
    }
}
