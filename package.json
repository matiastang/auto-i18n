{
    "name": "auto-i18n-vue",
    "version": "0.0.4",
    "description": "自动国际化",
    "packageManager": "pnpm@10.17.1",
    "main": "./dist/index.umd.js",
    "files": [
        "dist"
    ],
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.es.js",
            "require": "./dist/index.umd.js"
        }
    },
    "keywords": [
        "matias",
        "matiastang",
        "auto-i18n",
        "auto-i18n-vue"
    ],
    "author": {
        "name": "matiastang",
        "email": "matiastang@163.com"
    },
    "license": "Apache 2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/matiastang/auto-i18n.git"
    },
    "scripts": {
        "dev": "vite",
        "preview": "vite preview",
        "ts:build": "tsc --build src/autoi18n/tsconfig.json",
        "build": "vite --config vite.build.config.ts build --mode production",
        "type-check": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run",
        "test:all": "pnpm test && pnpm test:e2e",
        "test:watch": "vitest",
        "test:unit": "vitest run tests/unit",
        "test:integration": "vitest run tests/integration",
        "test:usecase": "vitest run tests/usecase",
        "test:e2e": "playwright test -c e2e/playwright.config.ts",
        "prepare": "husky",
        "cp:types": "cp src/autoi18n/@types/autoi18n.d.ts dist/@types && cp src/autoi18n/@types/autoi18nPlugin.d.ts dist/@types && cp src/autoi18n/@types/index.d.ts dist/@types",
        "cp:build:type": "cp -r src/autoi18n/buildTypes/* dist/",
        "rm:public:files": "rm dist/favicon.ico && rm dist/translate.json",
        "plugin:build": "pnpm run ts:build && pnpm run build && pnpm run cp:build:type && pnpm run cp:types && pnpm run rm:public:files",
        "push:npm:package": "gulp versionPatch && gulp npmPackagePush",
        "plugin:build:push:npm:package": "pnpm run plugin:build && pnpm run push:npm:package"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@playwright/test": "^1.62.1",
        "@types/gulp": "^4.0.17",
        "@types/gulp-bump": "^2.8.6",
        "@types/gulp-json-editor": "^2.2.36",
        "@types/node": "^20.3.1",
        "@vitejs/plugin-vue": "^4.2.3",
        "@vue/runtime-core": "^3.3.4",
        "@vue/test-utils": "^2.4.11",
        "auto-i18n-vue": "0.0.1",
        "css-vars-ponyfill": "^2.4.8",
        "gulp": "^4.0.2",
        "gulp-bump": "^3.2.0",
        "gulp-json-editor": "^2.6.0",
        "highlight.js": "^11.9.0",
        "husky": "^9.1.7",
        "jsdom": "^24.1.3",
        "less": "^4.1.3",
        "markdown-it": "^14.1.0",
        "markdown-it-emoji": "^3.0.0",
        "matias-pinia-persisted-state": "^0.2.0",
        "minimist": "^1.2.8",
        "pinia": "^2.1.4",
        "rollup": "^4.20.0",
        "rollup-plugin-terser": "^7.0.2",
        "sass": "^1.63.4",
        "shelljs": "^0.8.5",
        "ts-node": "^10.9.1",
        "typescript": "^5.1.3",
        "vite": "^4.3.9",
        "vite-plugin-inspect": "^0.7.28",
        "vitest": "^1.6.1",
        "vue": "^3.3.4",
        "vue-router": "^4.2.2"
    },
    "peerDependencies": {
        "vue": ">=3.2.0"
    },
    "dependencies": {
        "crypto-js": "^4.2.0"
    }
}
