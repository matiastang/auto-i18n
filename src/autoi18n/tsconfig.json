{
    "compilerOptions": {
        "target": "ES2015",  
        "module": "commonjs",
        // Type 'IterableIterator<RegExpExecArray>' can only be iterated through when using the '--downlevelIteration' flag or with a '--target' of 'es2015' or higher.ts(2802)
        // "downlevelIteration": true,
        "noEmit": false,
        "declaration": true,
        "declarationDir": "buildTypes",
        "outDir": "buildJs",
        "rootDir": "./",
        // TS2550: Property 'replaceAll' does not exist on type 'string'. Do you need to change your target library? Try changing the 'lib' compiler option to 'es2021' or later.
        "lib": ["ESNext", "DOM", "DOM.Iterable", "ScriptHost"],
        // Cannot find module '../../package.json'. Consider using '--resolveJsonModule' to import module with '.json' extension.ts(2732)
        "resolveJsonModule": true,
        // TS1259: Module '"path"' can only be default-imported using the 'esModuleInterop' flag
        "esModuleInterop": true,
    },
    "include": ["./index.ts"],
    "exclude": ["buildJs", "buildTypes"]
}
