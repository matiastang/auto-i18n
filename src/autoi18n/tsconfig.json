{
    "compilerOptions": {
        "noEmit": false,
        "declaration": true,
        "declarationDir": "buildTypes",
        "outDir": "buildJs",
        "rootDir": "./",
        // TS2550: Property 'replaceAll' does not exist on type 'string'. Do you need to change your target library? Try changing the 'lib' compiler option to 'es2021' or later.
        "lib": ["ESNext", "DOM", "DOM.Iterable", "ScriptHost"],
        // TS1259: Module '"path"' can only be default-imported using the 'esModuleInterop' flag
        "esModuleInterop": true,
    },
    "include": ["./index.ts"],
    "exclude": ["buildJs","buildTypes"]
}
